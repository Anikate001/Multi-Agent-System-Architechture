# ============================================
# Multi-Agent System — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# [REQUIRED] OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# [OPTIONAL] Tavily API Key for web search
# Get yours at: https://tavily.com
# If not set, the system will use a fallback search method
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# [OPTIONAL] Model Configuration
# Default: gpt-4o | Options: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# [OPTIONAL] Temperature (0 = deterministic, 1 = creative)
OPENAI_TEMPERATURE=0
