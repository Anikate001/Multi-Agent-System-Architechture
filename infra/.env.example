# ============================================================================
# NEXUS — Multi-Agent Research Platform
# Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# --------------------------------------------------------------------------
# 🔑 API Keys (Required)
# --------------------------------------------------------------------------

# Google Gemini API Key — powers all LLM agent reasoning
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Tavily API Key — web search tool for the Researcher agent
# Get yours at: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# --------------------------------------------------------------------------
# 🗄️ PostgreSQL Configuration
# --------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/nexus

# --------------------------------------------------------------------------
# 🔴 Redis Configuration
# --------------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0

# --------------------------------------------------------------------------
# 📊 LangSmith Observability (Optional)
# --------------------------------------------------------------------------
# Enable LangSmith tracing for debugging agent chains
# Get your key at: https://smith.langchain.com

LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nexus

# --------------------------------------------------------------------------
# ⚙️ Application Configuration
# --------------------------------------------------------------------------

# Logging level: debug, info, warning, error, critical
LOG_LEVEL=info

# Environment: development, staging, production
ENVIRONMENT=development

# Number of Uvicorn worker processes
BACKEND_WORKERS=2

# --------------------------------------------------------------------------
# 🤖 Agent Configuration
# --------------------------------------------------------------------------

# Maximum revision loops for Critic -> Writer feedback cycle
MAX_REVISION_LOOPS=3

# Minimum quality score (1-10) for auto-approval by Critic
MIN_QUALITY_SCORE=7

# Maximum tokens per agent invocation
MAX_TOKENS_PER_AGENT=4096

# Gemini model (gemini-2.0-flash was shut down on 1 June 2026)
# Flash-Lite fits the free tier; gemini-3.6-flash allows only ~20 requests/day (about 2 reports)
MODEL_NAME=gemini-3.5-flash-lite

# --------------------------------------------------------------------------
# 🛡️ Rate Limiting
# --------------------------------------------------------------------------

# Max requests per minute per user
RATE_LIMIT_RPM=30

# Max concurrent research sessions
MAX_CONCURRENT_SESSIONS=10

# --------------------------------------------------------------------------
# 🔐 Security
# --------------------------------------------------------------------------

# JWT secret for session management (generate a strong random string)
JWT_SECRET=change-me-to-a-random-secret

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
